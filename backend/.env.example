# LLM API Keys 配置文件
# 请将此文件复制为 .env 并填入您的实际API Key

# ========== 通义千问 (Qwen) ==========
# 获取地址: https://dashscope.console.aliyun.com/
# 免费额度: 100万tokens（新用户）
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ========== 智谱GLM ==========
# 获取地址: https://open.bigmodel.cn/
# 免费额度: 2000万tokens（新用户）
ZHIPUAI_API_KEY=your-zhipuai-api-key-here

# ========== Moonshot Kimi ==========
# 获取地址: https://platform.moonshot.cn/
# 免费额度: 15元（新用户）
MOONSHOT_API_KEY=your-moonshot-api-key-here

# ========== 火山引擎豆包 (Doubao) ==========
# 获取地址: https://console.volcengine.com/ark
# 免费额度: 请查看控制台
ARK_API_KEY=your-ark-api-key-here

# ========== 其他配置 ==========
# 默认使用的模型提供商 (qwen, glm, kimi, doubao)
DEFAULT_LLM_PROVIDER=qwen

# 日志级别
LOG_LEVEL=INFO
